+TeamFortress2.prototype.useItemOn = function(toolItemId, targetItemId) {
+	// CMsgUseItem field 8 (item_to_apply_action_to) is absent from the outdated proto definition.
+	// Encode manually with protobufjs Writer so field 8 is included in the wire bytes.
+	if (!this._steam.steamID) return false;
+	this.emit('debug', 'Sending GC message UseItemRequest (useItemOn)');
+	const $protobuf = require('protobufjs/minimal');
+	const Long = $protobuf.util.Long;
+	const writer = $protobuf.Writer.create();
+	writer.uint32(/* field 1, wire type 0 */ 8).uint64(Long.fromString(String(toolItemId), true));
+	writer.uint32(/* field 8, wire type 0 */ 64).uint64(Long.fromString(String(targetItemId), true));
+	this._steam.sendToGC(440, Language.UseItemRequest, {}, Buffer.from(writer.finish()));
+	return true;
+};
